# Neo debug profile: tracing, lock and memory debugging, verbose logs.
# Layered after waipio_perf.config and ingres_GKI.config.

# Tracers (function_graph, wakeup latency, irqsoff/preemptoff)
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_STACK_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_HWLAT_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y

# Logging
CONFIG_DYNAMIC_DEBUG=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=8
CONFIG_PRINTK_CALLER=y
CONFIG_LOG_BUF_SHIFT=21

# Locking and sleep-in-atomic checks
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_PREEMPT=y

# Memory debugging (KFENCE is low overhead; KASAN is a separate opt-in)
CONFIG_KFENCE=y
CONFIG_DEBUG_LIST=y
CONFIG_PAGE_OWNER=y
CONFIG_SLUB_DEBUG=y
CONFIG_SCHEDSTATS=y
