# Device layer for the 6.6 GKI build.
# Drop this into arch/arm64/configs/vendor/ingres_GKI.config in the 6.6 tree,
# or let scripts/build-kernel.sh merge it.
#
# VERIFY every symbol against the 6.6 Kconfig: 5.10 symbols may have been
# renamed or removed. merge_config.sh reports unknown symbols.

# Platform
CONFIG_ARCH_WAIPIO=y
# CONFIG_ARCH_CAPE is not set
# CONFIG_ARCH_DIWALI is not set

# Touch (ST/FocalTech FTS over QUPv3 SE4 SPI)
CONFIG_TOUCHSCREEN_PROPERTIES=y
CONFIG_TOUCHSCREEN_FTS=m
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Game key / hall
CONFIG_INPUT_XM_GAMEKEY=m

# LEDs
CONFIG_LEDS_AW_22XXX=m

# Haptics
# ingres DT: awinic,aw86297_haptic -> aw86927_haptic driver
CONFIG_INPUT_AW86927_HAPTIC=m

# Power / charger
CONFIG_BQ_FG_2S=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_MI_CHARGER_M81=y
CONFIG_MI_THERMAL_MULTI_CHARGE=y
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_WIRELESS=y
CONFIG_LDO_WL2866D=y
CONFIG_REGULATOR_WL2866D=m

# Hardware ID
CONFIG_MI_HARDWARE_ID=m

# Fingerprint
CONFIG_FINGERPRINT_FPC_1540=y
CONFIG_FINGERPRINT_GOODIX_TEE=y
CONFIG_INPUT_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y

# MTD / pstore
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# GPU (kgsl) and vendor display are external modules; do not enable mainline
# drm/msm here.
# CONFIG_DRM_MSM is not set

# 6.6 port: providers referenced by vendor storage/display/wlan modules.
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y
CONFIG_CRYPTO_ARC4=m
# CONFIG_MI_GAMEKEY is not set
CONFIG_FINGERPRINT_XIAOMI_FP=y
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=y
CONFIG_QTI_ADC_TM=m

# Debug sanitizers from gki_defconfig break boot: any UB becomes BUG() and
# PANIC_ON_OOPS reboots the device before pstore/USB come up.
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KFENCE is not set

# Debug: kernel console on the bootloader splash framebuffer (simple-framebuffer)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_8x16=y


# UFS PHY: waipio-mtp.dtsi uses qcom,ufs-phy-qmp-v4-waipio (cape driver does not match)
CONFIG_PHY_QCOM_UFS_V4_WAIPIO=m
