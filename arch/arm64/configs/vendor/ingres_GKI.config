# Device layer for the 6.6 GKI build.
# Drop this into arch/arm64/configs/vendor/ingres_GKI.config in the 6.6 tree,
# or let scripts/build-kernel.sh merge it.
#
# VERIFY every symbol against the 6.6 Kconfig: 5.10 symbols may have been
# renamed or removed. merge_config.sh reports unknown symbols.

# Platform
CONFIG_ARCH_WAIPIO=y
# CONFIG_ARCH_CAPE is not set
# CONFIG_ARCH_DIWALI is not set

# Touch (ST/FocalTech FTS over QUPv3 SE4 SPI)
CONFIG_TOUCHSCREEN_PROPERTIES=y
CONFIG_TOUCHSCREEN_FTS=m
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Game key / hall
CONFIG_INPUT_XM_GAMEKEY=m

# LEDs
CONFIG_LEDS_AW_22XXX=m

# Haptics
# ingres DT: awinic,aw86297_haptic -> aw86927_haptic driver
CONFIG_INPUT_AW86927_HAPTIC=m

# Power / charger
CONFIG_BQ_FG_2S=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_MI_CHARGER_M81=y
CONFIG_MI_THERMAL_MULTI_CHARGE=y
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_WIRELESS=y
CONFIG_LDO_WL2866D=y
CONFIG_REGULATOR_WL2866D=m

# Hardware ID
CONFIG_MI_HARDWARE_ID=m

# Fingerprint
CONFIG_FINGERPRINT_FPC_1540=y
CONFIG_FINGERPRINT_GOODIX_TEE=y
CONFIG_INPUT_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y

# MTD / pstore
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# GPU (kgsl) and vendor display are external modules; do not enable mainline
# drm/msm here.
# CONFIG_DRM_MSM is not set

# 6.6 port: providers referenced by vendor storage/display/wlan modules.
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y
CONFIG_CRYPTO_ARC4=m
# CONFIG_MI_GAMEKEY is not set
CONFIG_FINGERPRINT_XIAOMI_FP=y
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=y
CONFIG_QTI_ADC_TM=m

# Debug sanitizers from gki_defconfig break boot: any UB becomes BUG() and
# PANIC_ON_OOPS reboots the device before pstore/USB come up.
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KFENCE is not set

# Debug: kernel console on the bootloader splash framebuffer (simple-framebuffer)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_8x16=y


# UFS PHY: waipio-mtp.dtsi uses qcom,ufs-phy-qmp-v4-waipio (cape driver does not match)
CONFIG_PHY_QCOM_UFS_V4_WAIPIO=m

# USB Wi-Fi dongles over OTG (monitor mode / injection)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m

# Wine NT sync primitives (/dev/ntsync), backported from 6.17
CONFIG_NTSYNC=m

# KernelSU-Next (kprobes + syscall table hooks, no manual hooks, no SUSFS)
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set

# TCP: BBR as the default congestion control (fq qdisc is already built in)
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Filesystems for OTG drives and network shares
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y

# USB serial adapters (ESP32/Arduino); USB_SERIAL is =m, so these are modules
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m

# USB Bluetooth adapters (kernel HCI; BT is =m, so btusb is a module)
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y

# USB gadget: RNDIS tethering for Windows hosts
CONFIG_USB_CONFIGFS_RNDIS=y

# RTL-SDR / RTL2832U DVB-T dongles (SDR via DVB_RTL2832_SDR); modules
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_I2C_MUX=m
CONFIG_DVB_USB_V2=m
CONFIG_DVB_USB_RTL28XXU=m

# More USB Wi-Fi dongles for monitor/injection (cfg80211/mac80211 are modules); RTL8812AU is out-of-tree
CONFIG_MT76x2U=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m

# Containers / process checkpointing
CONFIG_USER_NS=y
CONFIG_CHECKPOINT_RESTORE=y
