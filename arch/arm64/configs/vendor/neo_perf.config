# Neo performance profile: minimal debug overhead and logging.
# Layered after waipio_perf.config and ingres_GKI.config.
# Security hardening that costs runtime (CFI, shadow call stack,
# init-on-alloc) is turned off on purpose.

# Memory and scheduler accounting
# CONFIG_PAGE_OWNER is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set

# Hardening with runtime cost
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# Stack zeroing stays on: Qualcomm vendor modules rely on it (IPA passes
# register-write params with unset fields and WARNs without it).

# Logging
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=3
CONFIG_CONSOLE_LOGLEVEL_QUIET=3
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4
# CONFIG_DEBUG_BUGVERBOSE is not set
